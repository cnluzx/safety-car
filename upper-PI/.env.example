# 复制为 .env 后按实际设备修改。run.sh 会自动加载。
# 完整参数清单见 src/full_map_walk_test.py 的 FullMapConfig 类。

# ── 串口 ──
# 查设备：ls -l /dev/serial/by-id/
CHASSIS_PORT=/dev/ttyUSB0
RFID_PORT=/dev/ttyACM0

# ── 摄像头 ──
# 查设备：v4l2-ctl --list-devices
NAV_CAMERA=2
NAV_CAMERA_FLIP=-1
CULVERT_CAMERA=0
CULVERT_CAMERA_FLIP=none

# ── 巡线 ──
FULL_MAP_LINE_SPEED=9
FULL_MAP_KP=0.5
FULL_MAP_KD=0.10
FULL_MAP_MAX_ANGLE=30
LINE_DEBUG=0

# ── 任务 ──
CULVERT_EXPECTED_COUNT=8
OBSTACLE_DETECT_ENABLED=1
OBSTACLE_DEBUG=0
CULVERT_SAVE_PHOTOS=1

# ── 可视化/音频目录（默认在项目内，一般不用改）──
# SOUND_DIR=
# CULVERT_YOLO_SAVE_DIR=
